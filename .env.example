# ─────────────────────────────────────────────────────────────────────

# One of: anthropic | openai | groq | gemini | ollama
MODEL_PROVIDER=anthropic

MODEL_NAME=

# Set only the one that matches MODEL_PROVIDER above.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Ollama (local) ──────────────────────────────────────────────────
# Default assumes a local Ollama daemon. Change if yours lives elsewhere.
OLLAMA_BASE_URL=http://localhost:11434
